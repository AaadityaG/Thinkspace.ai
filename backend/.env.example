APP_NAME=Thinkspace.ai
APP_VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173"]

# MongoDB
MONGO_DB=
MONGO_DB_NAME=thinkspace

# Auth (JWT_SECRET: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=

# AI — Google ADK / Gemini
# Get a key at https://aistudio.google.com/apikey (free tier works)
GOOGLE_API_KEY=
# Model the agents use for default; any Gemini model id, e.g. gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
